// spec_egress_splice_live.ae — LIVE full-duplex proof of egress_relay.splice,
// exercised through the real bin/aeo-egress-gateway binary.
//
// Aether `!` sends are synchronous (the sender blocks until the handler returns),
// so a blocking accept()/splice() in a spawned actor wedges the sender — actors
// are the wrong tool for a concurrent server here. True concurrency in aeo comes
// from OS subprocesses (the bench_bringup / pidfile-driver pattern). So this spec
// drives a small python harness (test/egress_splice_harness.py) that:
//   * stands up a loopback echo upstream,
//   * launches the built gateway with the echo host allowlisted,
//   * runs a CONNECT client that writes THREE chunks BEFORE reading any echo
//     (a burst the old half-duplex lockstep pump would deadlock on) and drains
//     all three — the full-duplex property, proven end to end,
//   * runs a second client whose non-allowlisted host must be 403'd at CONNECT.
//
// The harness prints `RESULT <name> PASS|FAIL ...` lines; this spec asserts them.
// Runs anywhere python3 + a built gateway are present (pure loopback, no network).
// Reports HARNESS_UNAVAILABLE (a skip, not a failure) if the binary or python is
// missing — the run-spec.sh wrapper builds the binary and stages the harness.

import std.spec
import std.os (run_capture)
import std.config
import std.string
import std.list (list_new, list_add, list_free)

const UP_PORT = 19771
const GW_PORT = 19772
const GW_BIN  = "/tmp/aeo-egress-gateway-live"
const HARNESS = "/tmp/egress_splice_harness.py"

main() {
    fw = spec.init()
    out = _run_harness()
    config.put("splice.out", out)

    // HONEST SKIPS (std.spec `it_when`, ae 0.545.0). When the harness can't run
    // — no python3, gateway not built — these report ⊘ skipped WITH THE REASON
    // and count in neither passed nor failed. They used to be gated by _ok(),
    // which returned 1 when unavailable so every assertion was VACUOUSLY
    // SATISFIED and the file reported "3 passing" having tested nothing. A box
    // that skipped everything looked exactly like a box that passed everything
    // — the precise failure mode #1610 was raised to kill, and a direct breach
    // of aeo's "never overclaim live" rule. run-spec.sh builds the gateway and
    // stages the harness, so under CI these run for real.
    ran = 1
    if _unavailable() == 1 {
        ran = 0
    }
    why = "harness unavailable — build ${GW_BIN} + install python3 to run live"

    spec.describe(fw, "egress_relay.splice — live full-duplex tunnel via the gateway binary") {
        spec.it_when(ran, "full-duplex: relays a write-burst-then-drain the half-duplex pump would stall on", why) callback {
            spec.expect_int(_ok("RESULT fullduplex PASS")).to_be_truthy()
        }
        spec.it_when(ran, "deny: a non-allowlisted CONNECT is 403'd before the splice", why) callback {
            spec.expect_int(_ok("RESULT deny PASS")).to_be_truthy()
        }
        spec.it_when(ran, "the harness reports overall PASS", why) callback {
            spec.expect_int(_ok("RESULT summary PASS")).to_be_truthy()
        }
    }

    return spec.run_summary(fw)
}

// Run the python harness, passing the gateway binary path + ports. Capture stdout.
_run_harness() -> string {
    av = list_new()
    list_add(av, HARNESS)
    list_add(av, GW_BIN)
    list_add(av, "${UP_PORT}")
    list_add(av, "${GW_PORT}")
    out, status, err = run_capture("/usr/bin/python3", av, null)
    list_free(av)
    if string.length(out) == 0 {
        return "HARNESS_UNAVAILABLE ${err}"
    }
    return out
}

_unavailable() -> int {
    if string.contains(config.get("splice.out"), "HARNESS_UNAVAILABLE") == 1 {
        return 1
    }
    return 0
}

// A check passes ONLY if the harness reported it PASS.
//
// The old version returned 1 when the harness was unavailable, so an absent
// python3 produced three vacuous passes. That escape hatch is GONE: the
// unavailable case is now expressed as a real skip (`it_when` above), which is
// the honest place for it — the body never runs, so this is never consulted.
// Do not re-add the short-circuit: it would make the assertions unfalsifiable
// again, and this time silently, since the ⊘ line would still be absent.
_ok(needle: string) -> int {
    if string.contains(config.get("splice.out"), needle) == 1 {
        return 1
    }
    return 0
}
