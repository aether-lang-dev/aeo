// spec_driver_loadbalancer_live.ae — LIVE lifecycle proof of driver_loadbalancer
// through the real aeo-lb CONTAINER (docs §9 step 2/3): up() runs the aeo-lb
// container on the backends' net publishing publish(), probe() sees it, the LB
// answers on its publish() port, down() stops it. Backend routing correctness
// (weighted split, health-eject, isolation) is proven end-to-end via `aeo up` on
// real podman (see the step-3 proof in docs/built_in_load_balancing.md §9); here
// the focus is the DRIVER lifecycle.
//
// Results are gathered into config BEFORE the describe() blocks. Requires the
// aeo-lb image (available() gates on it); self-skips as UNAVAILABLE otherwise.
// run-spec.sh builds the binary but NOT the image, so this spec typically skips
// under the plain suite and is exercised by the live `aeo up` proof instead.

import std.spec
import compose (system, container, load_balancer, listens, publish, balance_to, reset_nodes)
import driver_loadbalancer (up, down, probe, available)
import std.config
import std.os (run_capture)
import std.string
import std.list

const LB_PORT = 18810

_declare() {
    reset_nodes()
    system("lblive") {
        web = load_balancer("weblive", "container") {
            publish(18810)
            balance_to(18581)
            b = container("backend-x") { listens(18581) }   // placeholder; LB 502s but IS up
        }
    }
}

main() {
    fw = spec.init()
    _declare()

    avail = available()
    config.put("lb.avail", "${avail}")
    config.put("lb.up_err", "skip")
    config.put("lb.up_alive", "0")
    config.put("lb.answers", "0")
    config.put("lb.down_alive", "1")

    if avail == 1 {
        e = up("weblive")
        config.put("lb.up_err", e)
        pa = probe("weblive", "", "")
        config.put("lb.up_alive", "${pa}")
        ans = _answers()
        config.put("lb.answers", "${ans}")
        _ = down("weblive")
        pd = probe("weblive", "", "")
        config.put("lb.down_alive", "${pd}")
    }

    // HONEST SKIPS (std.spec `it_when`, ae 0.545.0). Each case used to open
    // with `if _skip() == 1 { expect_int(1).to_equal(1) }` — an always-true
    // placeholder that reported a PASS on a box without the aeo-lb image, so
    // "3 passing" meant nothing was exercised. `it_when` reports ⊘ with the
    // reason instead, and the assertions below are now unconditional: the body
    // simply does not run when the gate is false.
    why = "aeo-lb image absent (localhost/aeo/aeo-lb:latest) — build it to run live"

    spec.describe(fw, "driver_loadbalancer live lifecycle") {
        spec.it_when(avail, "up() starts a tracked LB process", why) callback {
            spec.expect_str(config.get("lb.up_err")).to_equal_str("")
            spec.expect_str(config.get("lb.up_alive")).to_equal_str("1")
        }
        spec.it_when(avail, "the LB answers on its publish() port", why) callback {
            spec.expect_str(config.get("lb.answers")).to_equal_str("1")
        }
        spec.it_when(avail, "down() stops the tracked process", why) callback {
            spec.expect_str(config.get("lb.down_alive")).to_equal_str("0")
        }
    }

    spec.run_summary(fw)
}

// (_skip() removed with the it_when conversion — it existed only to pick the
// always-true placeholder branch inside each it(). The gate is now the it_when
// condition itself, so there is nothing left to consult.)

// 1 if the LB answers HTTP at all (even 502 = it's up + listening). Polls briefly
// for the async bind, then curls. curl exit 0 (2xx/3xx) or 22 (HTTP error) both
// mean "answered".
_answers() -> int {
    i = 0
    while i < 25 {
        s = _curl()
        if s == 0 { return 1 }
        if s == 22 { return 1 }
        sleep(100)
        i = i + 1
    }
    return 0
}
_curl() -> int {
    av = list_new()
    list_add(av, "-s")
    list_add(av, "-o")
    list_add(av, "/dev/null")
    list_add(av, "--max-time")
    list_add(av, "2")
    list_add(av, "http://127.0.0.1:18810/")
    _o, status, _e = run_capture("/usr/bin/curl", av, null)
    list_free(av)
    return status
}
