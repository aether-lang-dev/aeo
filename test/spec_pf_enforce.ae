// spec_pf_enforce.ae — the ENFORCEMENT seam (lib/pf.resolve): the proven pf
// rulegen (spec_pf_rulegen) emits $<name> tokens; this proves they get
// substituted with the ipam-resolved IPs the driver booted each VM at, so the
// live firewall and the boot AGREE. The pure half — no root, no pfctl; runs
// anywhere. The `pfctl -f` load itself (lib/pf.apply) is FreeBSD+root, exercised
// on the GhostBSD box.
//
//   sh test/run-spec.sh test/spec_pf_enforce.ae
//
// Closes the model->live gap: spec_pf_rulegen proved the RIGHT rules are
// generated; this proves they're RESOLVED to real addresses ready for pfctl.

import std.spec
import compose (constrain, grant_fd, ingress_from, egress, ingress, deny_egress, pf_rules_for)
import pf (resolve, resolve_pinned, anchor_name, anchor_path, _pin_lookup, _ready_verdict, _count_rules)
import ipam (resolve_ip, reset_bindings)
import std.string (string_contains)

SYS() -> string { return "pfsys" }

main() {
    fw = spec.init()

    // Deterministic sticky bindings: resolve in declaration order so db_vm gets
    // the lowest IP, python_vm the next — the SAME order the runner resolves.
    reset_bindings(SYS())
    db_ip  = resolve_ip(SYS(), "db_vm")
    py_ip  = resolve_ip(SYS(), "python_vm")

    // The apex netpolicy (same as silly_addition_cache).
    constrain("db_vm")     { ingress_from(6379, "python_vm") deny_egress() }
    constrain("python_vm") { egress("db_vm", 6379) ingress(8080) }

    spec.describe(fw, "pf enforcement seam: tokens resolve to booted IPs") {

        spec.describe("db_vm rules") {
            spec.it("substitutes $db_vm and $python_vm with their ipam IPs") callback {
                r = resolve(SYS(), pf_rules_for("db_vm"))
                // peer-restricted ingress: from python_vm's IP to db_vm's IP:6379
                spec.expect_int(_has(r, "pass in proto tcp from ${py_ip} to ${db_ip} port 6379")).to_be_truthy()
                // deny-default catch-all on db_vm's resolved address
                spec.expect_int(_has(r, "block in proto tcp to ${db_ip}")).to_be_truthy()
                spec.expect_int(_has(r, "block out proto tcp from ${db_ip}")).to_be_truthy()
            }
            spec.it("leaves no $ tokens behind") callback {
                r = resolve(SYS(), pf_rules_for("db_vm"))
                spec.expect_int(_absent(r, "$")).to_be_truthy()
            }
        }

        spec.describe("python_vm rules") {
            spec.it("egress + ingress resolve to real addresses") callback {
                r = resolve(SYS(), pf_rules_for("python_vm"))
                spec.expect_int(_has(r, "pass out proto tcp from ${py_ip} to ${db_ip} port 6379")).to_be_truthy()
                spec.expect_int(_has(r, "pass in proto tcp to ${py_ip} port 8080")).to_be_truthy()
                spec.expect_int(_absent(r, "$")).to_be_truthy()
            }
        }

        spec.describe("per-VM anchor isolation") {
            spec.it("each VM loads into its OWN anchor (aeo/<vm>, distinct path)") callback {
                spec.expect_str(anchor_name("db_vm")).to_equal_str("aeo/db_vm")
                spec.expect_str(anchor_name("python_vm")).to_equal_str("aeo/python_vm")
                spec.expect_str(anchor_path("db_vm")).to_equal_str("/etc/pf.anchors/aeo-db_vm")
            }
        }
    }

    // A3 — the jail-address pin + the "will pf evaluate it?" preflight.
    constrain("jail_j") { deny_egress() }
    spec.describe(fw, "A3: a pinned (jail ip()) address wins over ipam") {
        spec.it("resolve_pinned uses the jail's declared ip, not an ipam address") callback {
            r = resolve_pinned(SYS(), pf_rules_for("jail_j"), "jail_j=10.77.3.10")
            spec.expect_int(_has(r, "block in proto tcp to 10.77.3.10")).to_be_truthy("the anchor must name the address the jail BOOTS at (driver_bsd ip4.addr = ip())")
            spec.expect_int(_has(r, "block out proto tcp from 10.77.3.10")).to_be_truthy()
            spec.expect_int(_absent(r, "$")).to_be_truthy()
        }
        spec.it("without a pin the SAME rules resolve through ipam (the old, wrong address for a jail)") callback {
            r = resolve(SYS(), pf_rules_for("jail_j"))
            spec.expect_int(_absent(r, "10.77.3.10")).to_be_truthy("negative control: proves the pin, not something else, moved the address")
        }
        spec.it("pins are exact-name: a pin for db never answers db_vm") callback {
            spec.expect_str(_pin_lookup("db=10.0.0.1\ndb_vm=10.0.0.2", "db_vm")).to_equal_str("10.0.0.2")
            spec.expect_str(_pin_lookup("db=10.0.0.1\ndb_vm=10.0.0.2", "db")).to_equal_str("10.0.0.1")
            spec.expect_str(_pin_lookup("db=10.0.0.1", "app")).to_equal_str("")
            spec.expect_str(_pin_lookup("", "db")).to_equal_str("")
        }
        spec.it("peers resolve through pins too (ingress_from a pinned jail)") callback {
            r = resolve_pinned(SYS(), pf_rules_for("db_vm"), "python_vm=10.77.3.20")
            spec.expect_int(_has(r, "pass in proto tcp from 10.77.3.20 to ${db_ip} port 6379")).to_be_truthy()
        }
    }
    spec.describe(fw, "A3: pf readiness — an anchor that pf will not evaluate is NOT enforcement") {
        spec.it("pfctl cannot open /dev/pf (pf.ko not loaded) -> not ready") callback {
            v = _ready_verdict("pfctl: /dev/pf: No such file or directory", 1, "")
            spec.expect_int(_has(v, "pf is not available")).to_be_truthy()
        }
        spec.it("pf loaded but disabled -> not ready") callback {
            v = _ready_verdict("Status: Disabled for 0 days 00:00:05   Debug: Urgent", 0, "anchor \"aeo/*\" all")
            spec.expect_int(_has(v, "DISABLED")).to_be_truthy()
        }
        spec.it("enabled but the main ruleset never references aeo/* -> not ready") callback {
            v = _ready_verdict("Status: Enabled for 0 days 00:00:05   Debug: Urgent", 0, "pass all flags S/SA keep state")
            spec.expect_int(_has(v, "does not reference anchor")).to_be_truthy()
        }
        spec.it("enabled + anchor \"aeo/*\" referenced -> ready") callback {
            spec.expect_str(_ready_verdict("Status: Enabled for 0 days 00:00:05   Debug: Urgent", 0, "pass all flags S/SA keep state\nanchor \"aeo/*\" all")).to_equal_str("")
        }
        spec.it("_count_rules counts non-blank listing lines (the post-load read-back)") callback {
            spec.expect_int(_count_rules("")).to_equal(0)
            spec.expect_int(_count_rules("block drop in inet proto tcp from any to 10.77.3.10\nblock drop out inet proto tcp from 10.77.3.10 to any\n")).to_equal(2)
            spec.expect_int(_count_rules("\n  \n")).to_equal(0)
        }
    }

    reset_bindings(SYS())   // leave no .aeo artifact behind
    return spec.run_summary(fw)
}

_has(hay: string, needle: string) -> int {
    if string_contains(hay, needle) == 1 { return 1 }
    return 0
}
_absent(hay: string, needle: string) -> int {
    if string_contains(hay, needle) == 1 { return 0 }
    return 1
}
