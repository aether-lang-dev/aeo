// spec_rctl_rulegen.ae — the limit{} block -> FreeBSD rctl rules (lib/rctl).
// Pure rulegen: caps recorded by limit_mem/cpu/maxproc/... become deny rules
// for a subject (jail:<name> or process:<pid>). The live `rctl -a` apply is
// FreeBSD + root + kern.racct.enable=1 (exercised on the GhostBSD box); this
// proves the RULE shape off-host.
//
//   sh test/run-spec.sh test/spec_rctl_rulegen.ae
//
// Where pf (spec_pf_rulegen) stops a node REACHING peers, rctl stops it
// STARVING the host — the exhaustion-DoS half of containment.

import std.spec
import compose (limit, limit_mem, limit_cpu, limit_maxproc, limit_openfiles, get_rctl)
import rctl (rules_for, apply)
import std.string (string_contains)

main() {
    fw = spec.init()

    // A node with a full set of caps (the apex db_vm could carry these).
    limit("db_vm") {
        limit_mem("2G")
        limit_cpu(150)
        limit_maxproc(512)
        limit_openfiles(4096)
    }

    spec.describe(fw, "limit{} -> rctl deny rules (exhaustion-DoS caps)") {

        spec.describe("the caps are recorded") {
            spec.it("get_rctl accumulates every limit_* setter") callback {
                spec.expect_str(get_rctl("db_vm")).to_equal_str("memoryuse=2G, pcpu=150, maxproc=512, openfiles=4096")
            }
        }

        spec.describe("rendered as rctl rules for a jail subject") {
            spec.it("each cap becomes jail:<vm>:RES:deny=AMT") callback {
                r = rules_for("db_vm", "jail")
                spec.expect_int(_has(r, "jail:db_vm:memoryuse:deny=2G")).to_be_truthy()
                spec.expect_int(_has(r, "jail:db_vm:pcpu:deny=150")).to_be_truthy()
                spec.expect_int(_has(r, "jail:db_vm:maxproc:deny=512")).to_be_truthy()
                spec.expect_int(_has(r, "jail:db_vm:openfiles:deny=4096")).to_be_truthy()
            }
        }

        spec.describe("the subject is parameterized (bhyve VM = a process)") {
            spec.it("renders for a process subject too") callback {
                r = rules_for("db_vm", "process")
                spec.expect_int(_has(r, "process:db_vm:memoryuse:deny=2G")).to_be_truthy()
            }
        }

        spec.describe("a node with no limits") {
            spec.it("renders nothing (no caps -> no rules)") callback {
                r = rules_for("unlimited_vm", "jail")
                spec.expect_str(r).to_equal_str("")
            }
        }

        // SAFETY INVARIANT: aeo must NEVER cap a user/loginclass subject — those
        // can hit the orchestrator's own identity and starve the control plane
        // (a user:<operator>:vmemoryuse:deny blocks sshd forks -> lockout, found
        // the hard way 2026-06-25). Only jail/process (node-scoped) are allowed.
        spec.describe("never-cap-the-orchestrator guard") {
            spec.it("rules_for REFUSES a user subject (empty, not a user: rule)") callback {
                r = rules_for("db_vm", "user")
                spec.expect_str(r).to_equal_str("")
            }
            spec.it("rules_for REFUSES loginclass too") callback {
                r = rules_for("db_vm", "loginclass")
                spec.expect_str(r).to_equal_str("")
            }
            spec.it("apply REFUSES a user subject LOUDLY (error, not silent no-op)") callback {
                e = apply("db_vm", "user")
                spec.expect_int(_has(e, "REFUSED")).to_be_truthy()
            }
            spec.it("jail + process subjects ARE allowed") callback {
                spec.expect_int(_has(rules_for("db_vm", "jail"), "jail:db_vm:")).to_be_truthy()
                spec.expect_int(_has(rules_for("db_vm", "process"), "process:db_vm:")).to_be_truthy()
            }
        }
    }

    return spec.run_summary(fw)
}

_has(hay: string, needle: string) -> int {
    if string_contains(hay, needle) == 1 { return 1 }
    return 0
}
