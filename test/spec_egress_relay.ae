// spec_egress_relay.ae — pure CONNECT-gateway core for egress_fqdn.
// No sockets here: this pins the parse/decision behavior before runtime wiring.

import std.spec
import egress_relay (
    is_connect, connect_host, connect_port, host_allowed,
    decision_status, decision_reason, response_for_status,
    splice_supported, splice_blocker, write_all
)
import std.string

main() {
    fw = spec.init()

    spec.describe(fw, "egress_relay CONNECT decision core") {
        spec.describe("CONNECT parsing") {
            spec.it("extracts lowercase host and port from the first line") callback {
                req = "CONNECT API.GitHub.com:443 HTTP/1.1\r\nHost: API.GitHub.com:443\r\n\r\n"
                spec.expect_int(is_connect(req)).to_be_truthy()
                spec.expect_str(connect_host(req)).to_equal_str("api.github.com")
                spec.expect_int(connect_port(req)).to_equal(443)
            }
            spec.it("rejects non-CONNECT and malformed authorities") callback {
                spec.expect_int(is_connect("GET / HTTP/1.1\r\n\r\n")).to_equal(0)
                spec.expect_str(connect_host("CONNECT api.github.com HTTP/1.1\r\n\r\n")).to_equal_str("")
                spec.expect_int(connect_port("CONNECT api.github.com:abc HTTP/1.1\r\n\r\n")).to_equal(0)
                spec.expect_int(connect_port("CONNECT api.github.com:70000 HTTP/1.1\r\n\r\n")).to_equal(0)
            }
        }

        spec.describe("allowlist decision") {
            spec.it("allows exact host matches, case-insensitively") callback {
                allow = "api.github.com, api.anthropic.com"
                spec.expect_int(host_allowed(allow, "API.GITHUB.COM")).to_be_truthy()
                spec.expect_int(host_allowed(allow, "uploads.github.com")).to_equal(0)
            }
            spec.it("returns 200 for allowed CONNECT before the splice") callback {
                req = "CONNECT api.github.com:443 HTTP/1.1\r\n\r\n"
                spec.expect_int(decision_status(req, "api.github.com")).to_equal(200)
                spec.expect_str(decision_reason(req, "api.github.com")).to_equal_str("allow")
                spec.expect_int(_has(response_for_status(200), "200 Connection Established")).to_be_truthy()
            }
            spec.it("returns 403 for a well-formed but unlisted host") callback {
                req = "CONNECT example.com:443 HTTP/1.1\r\n\r\n"
                spec.expect_int(decision_status(req, "api.github.com")).to_equal(403)
                spec.expect_str(decision_reason(req, "api.github.com")).to_equal_str("deny:not-allowlisted")
                spec.expect_int(_has(response_for_status(403), "403 Forbidden")).to_be_truthy()
            }
            spec.it("returns 400 for bad CONNECT shape") callback {
                req = "CONNECT api.github.com HTTP/1.1\r\n\r\n"
                spec.expect_int(decision_status(req, "api.github.com")).to_equal(400)
                spec.expect_str(decision_reason(req, "api.github.com")).to_equal_str("deny:bad-connect")
                spec.expect_int(_has(response_for_status(400), "400 Bad Request")).to_be_truthy()
            }
        }

        spec.describe("runtime splice readiness") {
            spec.it("claims opaque TCP splice support once std.tcp is length-aware") callback {
                spec.expect_int(splice_supported()).to_equal(1)
                spec.expect_str(splice_blocker()).to_equal_str("")
            }
            spec.it("write_all treats empty prefixes as a successful no-op") callback {
                wrote, err = write_all(null, "", 0)
                spec.expect_int(wrote).to_equal(0)
                spec.expect_str(err).to_equal_str("")
            }
        }
    }

    return spec.run_summary(fw)
}

_has(hay: string, needle: string) -> int {
    if string.contains(hay, needle) == 1 { return 1 }
    return 0
}
