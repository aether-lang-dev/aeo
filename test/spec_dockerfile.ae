// spec_dockerfile.ae — inline-Dockerfile heredoc built + run for real, as an
// Aeocha BDD spec. The describe/it form of demo_dockerfile.ae.
//
//   ae run test/spec_dockerfile.ae --lib lib
//
// Proves dockerfile(<<DOCKER…DOCKER) works end to end: aeo BUILDS the image
// from the inline Dockerfile and runs it, then reads back something the
// Dockerfile baked in — so the image is a real, buildable thing, not a
// fictional registry reference. Needs podman/docker; no root.

import std.spec
import driver_linux
import std.string

// The inline Dockerfile — what an operator would put in a
// container("app"){ dockerfile(<<DOCKER…DOCKER) } block. Bakes a marker file.
DF() -> string {
    return <<DOCKER
        FROM docker.io/library/busybox:latest
        RUN echo aeo-built-this > /etc/aeo-marker
        CMD ["sh","-c","sleep 600"]
DOCKER
}

main() {
    fw = spec.init()

    // HONEST SKIP GATE (std.spec `it_when`, ae 0.545.0). These cases drive a
    // REAL container engine; without one they used to take an
    // `expect_int(1).to_be_truthy()` branch and report a PASS having run
    // nothing — a box with no podman looked identical to a box where every
    // check succeeded. Now they report ⊘ with this reason.
    have_engine = 1
    if _no_engine() == 1 {
        have_engine = 0
    }
    why = "no container engine on PATH (podman/docker) — install one to run live"

    spec.describe(fw, "inline Dockerfile (built + run via aeo's driver)") {

        spec.before_each() callback {
            driver_linux.down("myapp", "")
        }
        spec.after_each() callback {
            driver_linux.down("myapp", "")
        }

        spec.it_when(have_engine, "builds the image from the inline Dockerfile, runs it, reads the baked-in marker", why) callback {
            // build
            berr = driver_linux.build("myapp", DF(), "")
            spec.expect_str(berr).to_equal_str("")
            tag = driver_linux.built_tag("myapp")
            // run + alive
            uerr = driver_linux.up("myapp", tag, "sleep 600", 0, "")
            spec.expect_str(uerr).to_equal_str("")
            spec.expect_int(driver_linux.probe("myapp", "", "")).to_equal(1)
            // the baked-in marker proves the image is OURS (built from the
            // heredoc), not a pulled stock image.
            marker = driver_linux.exec_capture("myapp", "cat /etc/aeo-marker", "")
            spec.expect_str(marker).to_equal_str("aeo-built-this")
            // and it still computes
            spec.expect_str(driver_linux.exec_capture("myapp", "echo $((2+2))", "")).to_equal_str("4")
        }

        spec.it_when(have_engine, "is gone after driver down", why) callback {
            driver_linux.build("myapp", DF(), "")
            driver_linux.up("myapp", driver_linux.built_tag("myapp"), "sleep 600", 0, "")
            driver_linux.down("myapp", "")
            spec.expect_int(driver_linux.probe("myapp", "", "")).to_equal(0)
        }
    }

    return spec.run_summary(fw)
}

_no_engine() -> int {
    if string.length(driver_linux.engine_resolve("")) == 0 {
        return 1
    }
    return 0
}
