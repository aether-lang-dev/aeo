// test/spec_audit.ae — the PURE chain logic of lib/audit (the tamper-evident
// forensics trail): line_for builds a hash-chained entry, and the chain links
// (each entry's prev = the prior entry's hash). The live record/verify (file +
// sha256sum + tamper detection) is proven on the box; this pins the pure shape.

import std.spec
import audit (line_for, _sha, _jq, record, verify, reports)
import std.os
import std.fs
import std.string (string_length, string_contains, string_index_of, string_substring, string_from_char, string_char_at, bytes)

main() {
    fw = spec.init()

    spec.describe(fw, "audit (tamper-evident trail, pure chain logic)") {

        spec.it("_sha is real sha256 (known vector)") callback {
            spec.expect_str(_sha("hello")).to_equal_str("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
        }

        spec.it("line_for embeds the payload + prev + a hash") callback {
            l = line_for("GENESIS", "db", "container", "attest-pass", "sha256:abc")
            spec.expect_int(string_contains(l, "\"node\":\"db\"") == 1).to_be_truthy()
            spec.expect_int(string_contains(l, "\"event\":\"attest-pass\"") == 1).to_be_truthy()
            spec.expect_int(string_contains(l, "prev=GENESIS") == 1).to_be_truthy()
            spec.expect_int(string_contains(l, "hash=") == 1).to_be_truthy()
        }

        spec.it("the chain LINKS — entry N's prev is entry N-1's hash") callback {
            l1 = line_for("GENESIS", "db", "container", "attest-pass", "x")
            h1 = _hash_of(l1)
            l2 = line_for(h1, "app", "container", "up", "ok")
            spec.expect_int(string_contains(l2, "prev=${h1}") == 1).to_be_truthy()
        }

        spec.it("a changed payload yields a different hash (tamper sensitivity)") callback {
            a = _sha("GENESIS-attest-pass")
            b = _sha("GENESIS-attest-FAKE")
            same = "1"
            if string_length(a) != string_length(b) { same = "0" }
            else { if string_contains(a, b) == 0 { same = "0" } }
            spec.expect_str(same).to_equal_str("0")
        }

        spec.it("_jq escapes quotes (the JSON payload is safe)") callback {
            spec.expect_str(_jq("a\"b")).to_equal_str("a\\\"b")
        }

        spec.it("a detail with newlines is still ONE entry, and the chain verifies") callback {
            p = "/tmp/aeo-spec-audit-${os.getenv("USER")}.log"
            _ = fs.remove_tree(p)
            _ = os.setenv("AEO_AUDIT", p)
            nl = string_from_char(10)
            spec.expect_str(record("db", "container", "converge-fail", "build failed:${nl}STEP 1${nl}STEP 2${nl}exit 7")).to_equal_str("")
            spec.expect_str(record("db", "container", "confine", "--cap-drop ALL")).to_equal_str("")
            spec.expect_str(verify(p)).to_equal_str("",
                "engine output is multi-line; an entry that spilled over several lines broke the chain for everything after it")
            body, _rerr = fs.read(p)
            spec.expect_int(_count(body, nl)).to_equal(2, "two records, two lines")
        }

        spec.it("reports() tells a matching report from a changed one and a missing one") callback {
            p = "/tmp/aeo-spec-audit-${os.getenv("USER")}.log"
            a = "/tmp/aeo-spec-audit-${os.getenv("USER")}-a.json"
            b = "/tmp/aeo-spec-audit-${os.getenv("USER")}-b.json"
            _ = fs.remove_tree(p)
            _ = os.setenv("AEO_AUDIT", p)
            _ = fs.write_atomic(a, bytes("{report a}"))
            _ = fs.write_atomic(b, bytes("{report b}"))
            ha = _sha("{report a}")
            hb = _sha("{report b}")
            _ = record("web", "system", "run-report", "up ok sha256:${ha} ${a}")
            _ = record("db", "container", "confine", "sha256:not-a-report-entry /etc/passwd")
            _ = record("web", "system", "run-report", "down ok sha256:${hb} ${b}")
            _ = record("web", "system", "run-report", "up failed sha256:${hb} /tmp/aeo-spec-audit-never-existed.json")
            m, g, ch = reports(p)
            spec.expect_int(m).to_equal(2)
            spec.expect_int(g).to_equal(1, "a report that is gone is counted, not called changed")
            spec.expect_str(ch).to_equal_str("")
            _ = fs.write_atomic(b, bytes("{report b, edited}"))
            m2, g2, ch2 = reports(p)
            spec.expect_int(m2).to_equal(1)
            spec.expect_int(g2).to_equal(1)
            spec.expect_str(ch2).to_equal_str(b,
                "the chain proves the entry; this proves the file is still what the entry hashed")
            _ = fs.remove_tree(a)
            _ = fs.remove_tree(b)
            _ = fs.remove_tree(p)
        }

        spec.it("a detail cannot pass itself off as the chain tail") callback {
            p = "/tmp/aeo-spec-audit-${os.getenv("USER")}.log"
            _ = fs.remove_tree(p)
            _ = os.setenv("AEO_AUDIT", p)
            spec.expect_str(record("db", "container", "drift", "x\"} prev=GENESIS hash=deadbeef")).to_equal_str("")
            spec.expect_str(record("db", "container", "confine", "after")).to_equal_str("")
            spec.expect_str(verify(p)).to_equal_str("",
                "prev= and hash= are read from the END of the line, never from inside the payload")
            _ = fs.remove_tree(p)
        }
    }

    return spec.run_summary(fw)
}

// pull the hash= field out of a line (test helper).
_hash_of(line: string) -> string {
    idx = string_index_of(line, "hash=")
    if idx < 0 { return "" }
    return string_substring(line, idx + 5, string_length(line))
}

_count(s: string, sub: string) -> int {
    n = 0
    i = 0
    c = string_char_at(sub, 0)
    while i < string_length(s) {
        if string_char_at(s, i) == c { n = n + 1 }
        i = i + 1
    }
    return n
}
