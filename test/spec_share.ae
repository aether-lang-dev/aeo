// spec_share.ae — the share() grammar (filesystem overlay INTO a node) and its
// per-substrate renderings.
//
// A share is a CAPABILITY GRANT (a filesystem pinhole through the boundary,
// the publish()/gpu() class): explicit per node, READ-ONLY by default
// (share_rw is the opt-in), repeatable, audit-recorded at up. This locks the
// PURE core — the model round-trip and the exact flags each local substrate
// renders (podman/docker -v, bwrap --ro-bind/--bind, nspawn --bind-ro=/
// --bind=). The behavioral ro/rw enforcement is proven live (a write inside
// an ro share must fail), not here.
//
//   sh test/run-spec.sh test/spec_share.ae

import std.spec
import compose
import driver_linux
import driver_bwrap
import driver_nspawn
import driver_vm
import driver_lxc
import std.list (list_get_raw, list_size, list_free)
import std.string

main() {
    fw = spec.init()
    spec.describe(fw, "share() — filesystem overlay into a node") {

        spec.describe("the compose model") {
            spec.it("share() records src|dst read-only; share_rw appends writable; repeatable") callback {
                compose.reset_nodes()
                compose.system("share_model") {
                    c = compose.container("c1") {
                        compose.image("docker.io/library/alpine:latest")
                        compose.share("/srv/data", "/data")
                        compose.share_rw("/srv/out", "/out")
                    }
                }
                spec.expect_str(compose.get_shares("c1")).to_equal_str("/srv/data|/data|ro\n/srv/out|/out|rw")
            }
            spec.it("reset_nodes clears shares (no capability bleed across compositions)") callback {
                compose.reset_nodes()
                compose.system("share_model2") {
                    c = compose.container("c1") {
                        compose.image("docker.io/library/alpine:latest")
                    }
                }
                spec.expect_str(compose.get_shares("c1")).to_equal_str("")
            }
        }

        spec.describe("driver_linux rendering (-v)") {
            spec.it("ro default -> -v src:dst:ro; rw -> -v src:dst") callback {
                s = "/srv/data|/data|ro\n/srv/out|/out|rw"
                av = driver_linux.run_argv_shared("c1", "img", "", 0, "", "", "", s)
                j = _join(av)
                spec.expect_str(j).to_contain("-v /srv/data:/data:ro")
                spec.expect_str(j).to_contain("-v /srv/out:/out ")
                list_free(av)
            }
        }

        spec.describe("bwrap rendering (--ro-bind/--bind, before /proc//dev//tmp)") {
            spec.it("ro default is --ro-bind; rw is --bind") callback {
                s = "/srv/data|/data|ro\n/srv/out|/out|rw"
                av = driver_bwrap.sandbox_argv_shared("", "sleep 1", s)
                j = _join(av)
                spec.expect_str(j).to_contain("--ro-bind /srv/data /data")
                spec.expect_str(j).to_contain("--bind /srv/out /out")
                list_free(av)
            }
            spec.it("no shares -> identical to the plain builder") callback {
                a = driver_bwrap.sandbox_argv_shared("", "sleep 1", "")
                b = driver_bwrap.sandbox_argv("", "sleep 1")
                spec.expect_str(_join(a)).to_equal_str(_join(b))
                list_free(a)
                list_free(b)
            }
        }

        spec.describe("kvm rendering (virtio-9p -virtfs exports)") {
            spec.it("ro gets readonly=on at the DEVICE; tags are aeoshN by order") callback {
                s = "/srv/data|/data|ro\n/srv/out|/out|rw"
                av = driver_vm.qemu_argv_shared("vic", "/tmp/d.qcow2", 1, "1G", "", "/tmp/p.pid", s)
                j = _join(av)
                spec.expect_str(j).to_contain("-virtfs local,path=/srv/data,mount_tag=aeosh0,security_model=none,readonly=on")
                spec.expect_str(j).to_contain("-virtfs local,path=/srv/out,mount_tag=aeosh1,security_model=none")
                list_free(av)
            }
        }

        spec.describe("lxc rendering (-s lxc.mount.entry, dst RELATIVE to rootfs)") {
            spec.it("ro default carries bind,ro; rw plain bind; leading slash stripped") callback {
                s = "/srv/data|/data|ro\n/srv/out|/out|rw"
                av = driver_lxc.start_argv_shared("c1", s)
                j = _join(av)
                spec.expect_str(j).to_contain("lxc.mount.entry=/srv/data data none bind,ro,create=dir 0 0")
                spec.expect_str(j).to_contain("lxc.mount.entry=/srv/out out none bind,create=dir 0 0")
                list_free(av)
            }
        }

        spec.describe("nspawn rendering (--bind-ro=/--bind=)") {
            spec.it("ro default is --bind-ro=src:dst; rw is --bind=src:dst") callback {
                s = "/srv/data|/data|ro\n/srv/out|/out|rw"
                av = driver_nspawn.run_argv_shared("db", "/var/lib/machines/db", "", s)
                j = _join(av)
                spec.expect_str(j).to_contain("--bind-ro=/srv/data:/data")
                spec.expect_str(j).to_contain("--bind=/srv/out:/out")
                list_free(av)
            }
        }
        spec.describe("share_model_errors — the loud gate for unwired kinds") {
            spec.it("firecracker is REFUSED by construction; proxmox not-yet-rendered; wired kinds pass") callback {
                compose.reset_nodes()
                compose.system("share_gate") {
                    // cnode FIRST: VM-opener kinds float curhost onto later
                    // siblings, which would make cnode read as nested.
                    c = compose.container("cnode") {
                        compose.image("docker.io/library/alpine:latest")
                        compose.share("/srv/data", "/data")
                    }
                    f = compose.firecracker("fnode") {
                        compose.image("/tmp/bundle")
                        compose.share("/srv/data", "/data")
                    }
                    p = compose.proxmox_vm("pnode") {
                        compose.share("/srv/data", "/data")
                    }
                }
                e = compose.share_model_errors()
                spec.expect_str(e).to_contain("REFUSED")
                spec.expect_str(e).to_contain("fnode")
                spec.expect_str(e).to_contain("pnode")
                spec.expect_str(e).to_contain("not rendered yet")
                // the wired container node contributes NO error line
                if string_contains(e, "cnode") == 1 {
                    spec.expect_str("cnode-should-not-error").to_equal_str("")
                }
            }
            spec.it("a nested-in-VM container share is refused (delegate path carries none)") callback {
                compose.reset_nodes()
                compose.system("share_gate2") {
                    vm = compose.kvm_vm("host_vm") {
                        compose.image("/tmp/d.qcow2")
                        nested = compose.container("napp") {
                            compose.image("docker.io/library/alpine:latest")
                            compose.share("/srv/data", "/data")
                        }
                    }
                }
                spec.expect_str(compose.share_model_errors()).to_contain("NESTED in a VM guest")
            }
            spec.it("no shares anywhere -> no errors") callback {
                compose.reset_nodes()
                compose.system("share_gate3") {
                    c = compose.container("plain") {
                        compose.image("docker.io/library/alpine:latest")
                    }
                }
                spec.expect_str(compose.share_model_errors()).to_equal_str("")
            }
        }
    }
    spec.run_summary(fw)
}

// join an argv list with single spaces.
_join(av: ptr) -> string {
    s = ""
    n = list_size(av)
    i = 0
    while i < n {
        it = list_get_raw(av, i)
        if i == 0 {
            s = "${it}"
        } else {
            s = "${s} ${it}"
        }
        i = i + 1
    }
    return s
}
