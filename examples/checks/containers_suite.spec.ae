// examples/checks/containers_suite.spec.ae — the fuller POST-DEPLOY suite for
// silly_addition_containers. Declared by `suite(...)` in that example; run by
// `aeo suite examples/silly_addition_containers.ae` AFTER the tree is up. aeo TEARS
// DOWN once the suite finishes (the CI shape). Fuller than smoke: more arithmetic
// plus the cache-read behaviour.
//
//   AEO_APP_HOST=<host> sh test/run-spec.sh examples/checks/containers_suite.spec.ae

import std.spec
import std.http.client.httptest   // the HTTP-shaped matchers (bare: selective form leaves the module's retry-state vars unresolved)
import std.os
import std.string (string_length)

_base() -> string {
    h = os.getenv("AEO_APP_HOST")
    if string_length(h) == 0 {
        h = "localhost"
    }
    return "http://${h}:8080"
}

main() {
    fw = spec.init()
    spec.describe(fw, "silly_addition_containers — full suite") {
        spec.it("app computes arithmetic over HTTP (2+2=4, 2+3=5, 40+2=42)") callback {
            base = _base()
            httptest.expect_http_get_body_eq("${base}/add/2/2", "4", "2 + 2 = 4")
            httptest.expect_http_get_body_eq("${base}/add/2/3", "5", "2 + 3 = 5")
            httptest.expect_http_get_body_eq("${base}/add/40/2", "42", "40 + 2 = 42")
        }
    }
    spec.run_summary(fw)
}
