// lib/driver_linux — Linux container backend (podman / docker).
//
// The load-bearing 80% of a backend: idempotent up/down plus a liveness
// probe, all shelling through os.run_capture (argv-based, no shell). The
// DSL layer above is substrate-agnostic; THIS file is where "linux means
// a container engine" actually lives.
//
// Engine selection: prefer `podman` (rootless, no daemon) then `docker`.
// Override per-resource with engine("docker"). Resolved once via os.which
// so a host without either fails loud rather than three nodes deep.
//
// Idempotency is the contract that makes re-running a composition safe:
//   up    — if a container of this name is already running, no-op; if it
//           exists but is stopped, start it; else create+run it.
//   down  — stop then rm; absent container is success, not error.
//   probe — (alive, err): 1 if running AND (no health_check, or the
//           health_check command exits 0 inside the container).
//
// All builders are pure string/argv assembly so they can be unit-tested
// without a daemon; the exec is isolated in up/down/probe.

import std.os (run_capture, run_full, os_which)
import std.list
import std.string (string_length, string_contains, string_char_at, string_substring, string_index_of, string_ends_with, string_get_int)
import std.fs (write_atomic)
import host

exports (
    name, engine_resolve, ensure_engine,
    up, up_net, up_confined, up_confined2, up_green, alias_move, network_ensure, network_ensure_internal, down, down_many, down_many_command, probe, inspect_argv, inspect_state, death_argv, death_state, list_running, extract_argv, extract_facts, image_digest, exec_capture, build, build_entrypoint, build_from_containerfile, built_tag, run_argv_shared, run_argv_full,
    ps_running_argv, ps_all_running_argv, running_names, run_argv, run_argv_net, run_argv_confined, stop_argv, rm_argv, exec_health_argv,
    net_disconnect_argv, net_connect_alias_argv,
    pasta_dropin_path, pasta_dropin_content, pasta_forwarder_ensure, pasta_forwarder_active, pasta_forwarder_clear,
    build_argv
)

name() -> string {
    return "linux"
}

// Resolve the container engine binary. `pref` is a preference ("" =
// auto). Returns the absolute path, or "" if none found.
// NULL-SAFE: os_which returns null (not "") for a missing binary, and null
// passes a `!= ""` test — the un-guarded podman miss used to return NULL here,
// so every docker-only host (no podman) ran `(null) run ...` and failed exit
// 127. Same class as the getenv footgun; bwrap/firecracker's available()
// already guard it.
engine_resolve(pref: string) -> string {
    if pref != "" {
        p = os_which(pref)
        if p == null {
            return ""
        }
        return p
    }
    p = os_which("podman")
    if p != null {
        if p != "" {
            return p
        }
    }
    d = os_which("docker")
    if d == null {
        return ""
    }
    return d
}

// ensure_engine — resolve the container engine, self-installing podman if absent
// (best-effort) so a podman-LESS host becomes usable through the agent alone.
// The SHARED "auto-ready engine" entry point: driver_linux.up and any driver that
// depends on a local podman (driver_loadbalancer, and driver_windows' in-distro
// analog) call THIS instead of engine_resolve, so the bootstrap lives in one
// place. Returns the engine path, or "" if none found after the install attempt.
// Opt-out with AEO_LINUX_AUTOINSTALL=0 (then it degrades to a plain resolve).
ensure_engine(pref: string) -> string {
    eng = engine_resolve(pref)
    if eng != "" {
        return eng
    }
    if _autoinstall_on() == 0 {
        return ""
    }
    _install_podman()
    return engine_resolve(pref)
}

// 1 unless AEO_LINUX_AUTOINSTALL is explicitly "0" — self-bootstrap the engine
// by default so a fresh podman-less host becomes usable through the agent alone.
_autoinstall_on() -> int {
    v = getenv("AEO_LINUX_AUTOINSTALL")
    if v == null {
        return 1
    }
    if v == "0" {
        return 0
    }
    return 1
}

// Best-effort install of podman via apt (Debian / Raspberry Pi OS — the arm64
// fleet). Self-sudo (the agent runs unprivileged; the operator pre-authorizes apt
// NOPASSWD, same contract as the lxc/nspawn/kata drivers). Synchronous: the caller
// re-resolves the engine after this returns, so a boot that triggered the install
// completes once apt finishes (may take a minute on a cold cache — the async
// delegate path already tolerates minutes; a direct http boot should use the
// background/pending flow for a cold host). Non-apt hosts: the `command -v apt-get`
// guard makes this a clean no-op.
// Install podman via the host's package manager (apt/dnf/yum/zypper/pacman/apk/
// pkg/brew — host.pkg_install detects it), retried + silent. `podman` is the
// package name on every one of them, so no per-manager name mapping is needed.
_install_podman() {
    _ = host.pkg_install("podman", "podman")
}

// --- pure argv builders (one per engine subcommand) ------------------

// `<engine> ps --filter name=^NAME$ --filter status=running --format {{.Names}}`
// Output is the container name iff it's running, else empty.
ps_running_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "ps")
    list_add(av, "--filter")
    list_add(av, "name=^${res_name}$")
    list_add(av, "--filter")
    list_add(av, "status=running")
    list_add(av, "--format")
    list_add(av, "{{.Names}}")
    return av
}

// `<engine> ps --filter status=running --format {{.Names}}` — the batch form of
// ps_running_argv with NO name filter: every running container's name,
// newline-separated. Lets the engine's per-level poller check all health-less
// container/docker nodes with ONE `ps` instead of one per node.
ps_all_running_argv() -> ptr {
    av = list_new()
    list_add(av, "ps")
    list_add(av, "--filter")
    list_add(av, "status=running")
    list_add(av, "--format")
    list_add(av, "{{.Names}}")
    return av
}

// running_names — the newline-separated names of every running container ("" if
// no engine). The batch liveness query the engine intersects against a level's
// health-less container/docker nodes.
running_names(engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return ""
    }
    av = ps_all_running_argv()
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return ""
    }
    if status != 0 {
        return ""
    }
    return out
}

// `<engine> run -d --name NAME --replace [-p PORT:PORT] IMAGE [/bin/sh -c CMD]`
// — detached, idempotent via --replace. `cmd` "" = image default entrypoint;
// non-empty runs under `/bin/sh -c`. `expose` > 0 publishes PORT:PORT so the
// host can reach the service (the expose() declaration's container realization).
run_argv(res_name: string, image: string, cmd: string, expose: int) -> ptr {
    return run_argv_net(res_name, image, cmd, expose, "", "")
}

// run_argv_net — like run_argv, plus a shared `net` (so peers resolve by name)
// and `env` ("K=V,K=V" pairs). net "" -> default network; env "" -> none.
run_argv_net(res_name: string, image: string, cmd: string, expose: int, net: string, env: string) -> ptr {
    return run_argv_confined(res_name, image, cmd, expose, net, env, "")
}

// run_argv_confined — adds `confine`, a space-separated string of confinement
// flag tokens from lib/confine_linux (cgroup caps + cap-drop/seccomp + netpolicy).
// If confine carries its own `--network` (a deny_egress -> --network none), THAT
// wins and the shared `net` is suppressed (a confined node's net policy overrides
// the default join). When deny_egress sets --network none, host port publish (-p)
// is also dropped (none = no network at all).
run_argv_confined(res_name: string, image: string, cmd: string, expose: int, net: string, env: string, confine: string) -> ptr {
    return _run_argv_core(res_name, image, cmd, expose, net, env, confine, "", 1)
}

// run_argv_confined plus share() mounts (the pure, spec-testable surface for
// the -v rendering; up_confined threads the same shares through the core).
run_argv_shared(res_name: string, image: string, cmd: string, expose: int, net: string, env: string, confine: string, shares: string) -> ptr {
    return _run_argv_core(res_name, image, cmd, expose, net, env, confine, shares, 1)
}

// run_argv_full — the full pure argv surface incl. `inner` (asymmetric publish
// container-port; 0=symmetric) and `ep` (exec_entrypoint path; ""=sh -c form).
// The spec-testable peer of up_confined2. up_confined2 threads the same signals.
run_argv_full(res_name: string, image: string, cmd: string, expose: int, inner: int, ep: string, net: string, env: string, confine: string, shares: string) -> ptr {
    return _run_argv_core2(res_name, image, cmd, expose, inner, ep, net, env, confine, shares, 1)
}

// The engine-portable core. `with_replace` 1 emits podman's `--replace`
// (in-place idempotency); 0 omits it — docker has no such flag, so the docker
// path gets its idempotency from a pre-`rm -f` in up_confined/up_green instead.
_run_argv_core(res_name: string, image: string, cmd: string, expose: int, net: string, env: string, confine: string, shares: string, with_replace: int) -> ptr {
    return _run_argv_core2(res_name, image, cmd, expose, 0, "", net, env, confine, shares, with_replace)
}

// _run_argv_core2 — _run_argv_core plus two additive signals:
//   inner  — the container-side port for an ASYMMETRIC publish; 0 means
//            symmetric (fall back to `expose:expose`). Renders `-p expose:inner`.
//   ep     — an exec_entrypoint() path; when non-empty, emit `--entrypoint <ep>`
//            and pass `cmd` as the container's ARGS (split on spaces), NOT wrapped
//            in `/bin/sh -c`. Empty ep keeps the shell-string convenience form.
_run_argv_core2(res_name: string, image: string, cmd: string, expose: int, inner: int, ep: string, net: string, env: string, confine: string, shares: string, with_replace: int) -> ptr {
    av = list_new()
    list_add(av, "run")
    list_add(av, "-d")
    if with_replace == 1 {
        list_add(av, "--replace")
    }
    // exec_entrypoint -> --entrypoint <path> (before the image, podman/docker
    // semantics). Distinct from the sh -c convenience form below.
    if string_length(ep) > 0 {
        list_add(av, "--entrypoint")
        list_add(av, ep)
    }
    list_add(av, "--name")
    list_add(av, res_name)
    confine_has_net = string_contains(confine, "--network")
    if string_length(net) > 0 {
        if confine_has_net == 0 {
            list_add(av, "--network")
            list_add(av, net)
        }
    }
    // splice the confinement flag tokens (cgroup/security/network).
    _add_token_args(av, confine)
    // share() mounts — argv-listed directly (paths may contain spaces, so they
    // must NOT ride the space-split confine channel).
    _add_share_args(av, shares)
    if string_length(env) > 0 {
        _add_env_args(av, env)
    }
    // publish the port UNLESS the node is network-isolated (--network none).
    // Asymmetric map: `-p expose:inner`. inner<=0 collapses to expose:expose (the
    // symmetric expose() form).
    no_net = string_contains(confine, "--network none")
    if expose > 0 {
        if no_net == 0 {
            hostside = expose
            contside = expose
            if inner > 0 {
                contside = inner
            }
            list_add(av, "-p")
            list_add(av, "${_itoa(hostside)}:${_itoa(contside)}")
        }
    }
    list_add(av, image)
    // With an exec_entrypoint, cmd is the container's ARGS (space-split), NOT a
    // shell string — matching `podman run --entrypoint EP IMAGE arg1 arg2`. This
    // also avoids `sh -c` mis-parsing a leading-dash arg. Without an entrypoint,
    // keep the `/bin/sh -c "<cmd>"` convenience form.
    if string_length(cmd) > 0 {
        if string_length(ep) > 0 {
            _add_token_args(av, cmd)
        } else {
            list_add(av, "/bin/sh")
            list_add(av, "-c")
            list_add(av, cmd)
        }
    }
    return av
}

// splice a space-separated flag string into the argv as individual tokens.
_add_token_args(av: ptr, flags: string) {
    if string_length(flags) == 0 {
        return
    }
    rest = flags
    more = 1
    while more == 1 {
        sp = string_index_of(rest, " ")
        if sp < 0 {
            if string_length(rest) > 0 {
                list_add(av, rest)
            }
            more = 0
        } else {
            tok = string_substring(rest, 0, sp)
            if string_length(tok) > 0 {
                list_add(av, tok)
            }
            rest = string_substring(rest, sp + 1, string_length(rest))
        }
    }
}

// share() mounts: one `src|dst|mode` entry per line -> `-v src:dst:ro` (the
// read-only DEFAULT) or `-v src:dst` (explicit share_rw). No auto-:Z — the
// SELinux relabel decision is the operator's (the documented Fedora-family
// trap; a wrong :Z on $HOME relabels the host).
_add_share_args(av: ptr, shares: string) {
    rest = shares
    more = 1
    if string_length(rest) == 0 {
        more = 0
    }
    while more == 1 {
        nl = string_index_of(rest, "\n")
        one = rest
        if nl >= 0 {
            one = string_substring(rest, 0, nl)
            rest = string_substring(rest, nl + 1, string_length(rest))
        } else {
            more = 0
        }
        p1 = string_index_of(one, "|")
        if p1 > 0 {
            src = string_substring(one, 0, p1)
            r2 = string_substring(one, p1 + 1, string_length(one))
            p2 = string_index_of(r2, "|")
            if p2 > 0 {
                dst = string_substring(r2, 0, p2)
                mode = string_substring(r2, p2 + 1, string_length(r2))
                list_add(av, "-v")
                if string_contains(mode, "rw") == 1 {
                    list_add(av, "${src}:${dst}")
                } else {
                    list_add(av, "${src}:${dst}:ro")
                }
            }
        }
    }
}

// split "K=V,K=V" and append `-e K=V` for each to the argv list.
_add_env_args(av: ptr, env: string) {
    rest = env
    more = 1
    while more == 1 {
        idx = string_index_of(rest, ",")
        one = rest
        if idx >= 0 {
            one = string_substring(rest, 0, idx)
            rest = string_substring(rest, idx + 1, string_length(rest))
        } else {
            more = 0
        }
        if string_length(one) > 0 {
            list_add(av, "-e")
            list_add(av, one)
        }
    }
}

// network_ensure(net, engine_pref) — create the shared podman/docker network if
// absent (idempotent: an existing network is success). Containers on the same
// network resolve each other by name. Returns "" on success.
network_ensure(net: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine for network '${net}'"
    }
    av = list_new()
    list_add(av, "-c")
    // `network inspect` is the ENGINE-PORTABLE existence test (`network exists`
    // is podman-only; docker's unknown-subcommand failure made every ensure
    // re-run `create`, which errors once the net exists).
    list_add(av, "${eng} network inspect ${net} >/dev/null 2>&1 || ${eng} network create ${net} >/dev/null 2>&1")
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if status != 0 {
        return "aeo: network create '${net}' failed: ${out}"
    }
    return ""
}

// network_ensure_internal — like network_ensure but creates an `--internal`
// network: containers on it resolve + reach EACH OTHER by name, but CANNOT reach
// the host/internet. The per-flow netpolicy "internal" tier (a node with declared
// peer egress but no external need -> can't phone home). Idempotent.
network_ensure_internal(net: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine for network '${net}'"
    }
    av = list_new()
    list_add(av, "-c")
    list_add(av, "${eng} network inspect ${net} >/dev/null 2>&1 || ${eng} network create --internal ${net} >/dev/null 2>&1")
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if status != 0 {
        return "aeo: internal network create '${net}' failed: ${out}"
    }
    return ""
}

// --- pasta port-forwarder: preserve the client source IP (rootless) --------
//
// A rootless published port (`-p`) defaults to `rootlessport`, a userspace proxy
// that REWRITES the source to its own gateway (192.168-side clients arrive as
// 169.254.x — proven live on podman 6.0.0). Any IP-based defence (brute-force
// lockout, ban lists) and the audit trail then see a proxy address, not the real
// client. The fix is a containers.conf drop-in switching the forwarder to `pasta`
// (kernel-level forwarding via "pesto"), which preserves the client source IP.
//
// STATUS — root-caused live 2026-07-05 (podman 6.0.0 + pasta/pesto 2026_06_11):
// the drop-in switches the forwarder to pasta AND, for a container on a BRIDGE net
// (which is exactly what aeo's up path uses — aeo-<system>), the pesto path fully
// engages: podman starts a shared `pasta … -c …/pasta.sock` instance and pesto
// registers the ports (the #28478 mechanism — VERIFIED: the pasta.sock control
// socket is present). This is NOT upstream-pending; podman 6.0.0 ships pesto and it
// runs. The ONE thing not provable on this box: whether a genuine EXTERNAL LAN
// client's source survives — because pasta starts with `--map-guest-addr 169.254.1.2`,
// so HOST-originated traffic to a published port (host hitting its own -p) is mapped
// to that guest-addr by pasta's loopback/splice path BY DESIGN; only a real remote
// host over the LAN interface takes the TAP path where the true source is preserved.
// We had no third host on the box's LAN to prove that arm. So: the mechanism aeo
// writes is correct and fully wired; source-IP preservation for external clients is
// pasta's documented behavior on this path but UNVERIFIED here (test-harness limit,
// not an aeo gap or an upstream wait). pasta_forwarder_active() reports what's in
// effect; nothing here claims a preservation we observed.

// pasta_dropin_path() — the canonical drop-in aeo writes. A dedicated aeo-owned
// file (not the base containers.conf) so it's idempotent + cleanly removable.
pasta_dropin_path() -> string { return "/etc/containers/containers.conf.d/aeo-pasta.conf" }

// pasta_dropin_content() — the exact file body. Pure (unit-tested): the [network]
// stanza selecting pasta as the rootless port forwarder.
pasta_dropin_content() -> string { return "[network]\nrootless_port_forwarder = \"pasta\"\n" }

// pasta_forwarder_ensure(engine_pref) — idempotently install the drop-in (root, via
// `sudo -n` — never prompt: the operator must have the NOPASSWD grant for mkdir/tee,
// same contract as the pf/nspawn/lxc host writes; see docs/linux-host-setup.md).
// FULL binary paths so a path-specific NOPASSWD rule matches. Returns "" on success,
// else a diagnostic (a TTY-prompt failure surfaces as the missing-grant hint).
pasta_forwarder_ensure(engine_pref: string) -> string {
    p = pasta_dropin_path()
    body = pasta_dropin_content()
    av = list_new()
    list_add(av, "-c")
    list_add(av, "sudo -n /usr/bin/mkdir -p /etc/containers/containers.conf.d && printf '%b' '${body}' | sudo -n /usr/bin/tee ${p} >/dev/null")
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if status != 0 {
        return "aeo: pasta drop-in write failed (${p}) — need NOPASSWD sudo for /usr/bin/mkdir + /usr/bin/tee (see docs/linux-host-setup.md): ${out}"
    }
    return ""
}

// pasta_forwarder_active(engine_pref) — the AUDIT/self-attest read: 1 if the pasta
// forwarder drop-in is in effect (the aeo drop-in present AND selecting pasta), 0
// otherwise. This is the honest "what is actually forwarding my ports" probe — a
// node whose ingress preserves the real client IP is more defensible (§5.4).
pasta_forwarder_active(engine_pref: string) -> int {
    p = pasta_dropin_path()
    av = list_new()
    list_add(av, "-c")
    list_add(av, "grep -qE 'rootless_port_forwarder[[:space:]]*=[[:space:]]*.?pasta' ${p} 2>/dev/null && echo yes || echo no")
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if string_contains(out, "yes") == 1 {
        return 1
    }
    return 0
}

// pasta_forwarder_clear(engine_pref) — remove the drop-in (revert to rootlessport).
// Also the teardown guard for podman #29032 (stale pasta forward rules conflict on
// restart): clearing the drop-in + a fresh bring-up avoids the stuck-port failure.
pasta_forwarder_clear(engine_pref: string) -> string {
    p = pasta_dropin_path()
    av = list_new()
    list_add(av, "-c")
    list_add(av, "sudo -n /usr/bin/rm -f ${p} 2>/dev/null; echo done")
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    return ""
}

// `<engine> stop -t 5 NAME`
stop_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "stop")
    list_add(av, "-t")
    list_add(av, "5")
    list_add(av, res_name)
    return av
}

// `<engine> rm -f NAME`
rm_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "rm")
    list_add(av, "-f")
    list_add(av, res_name)
    return av
}

// --- blue-green cutover: network-alias swap primitives ---------------------
//
// The zero-downtime cutover mechanism (proven live on podman 6): a service alias
// on the shared net names the LIVE version. blue holds it; green is staged beside
// blue on the SAME bridge net; then the alias moves to green and blue's is dropped
// — a client resolving http://<alias> switches blue->green with no address change.
//
// PODMAN-6 GOTCHAS baked in here (learned live): (1) both must be on a BRIDGE net
// from creation — a container defaulting to podman-6's `pasta` net can't be
// `network connect`'d; up_confined already joins the shared net, so that holds.
// (2) re-aliasing an already-connected container needs disconnect THEN connect
// --alias (podman refuses a second connect).

// `<engine> network disconnect NET NAME`
net_disconnect_argv(net: string, res_name: string) -> ptr {
    av = list_new()
    list_add(av, "network")
    list_add(av, "disconnect")
    list_add(av, net)
    list_add(av, res_name)
    return av
}

// `<engine> network connect --alias ALIAS NET NAME`
net_connect_alias_argv(net: string, res_name: string, alias: string) -> ptr {
    av = list_new()
    list_add(av, "network")
    list_add(av, "connect")
    list_add(av, "--alias")
    list_add(av, alias)
    list_add(av, net)
    list_add(av, res_name)
    return av
}

// alias_move(net, from_name, to_name, alias, engine_pref) — atomically-ish move the
// service `alias` on `net` from `from_name` (blue) to `to_name` (green): give green
// the alias (disconnect+reconnect-with-alias, per gotcha 2), then drop blue from the
// net so only green answers `alias`. Both must already be on `net`. Returns "" on
// success. The cutover instant is when green gains the alias.
alias_move(net: string, from_name: string, to_name: string, alias: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine for alias move on '${net}'"
    }
    // green: disconnect then reconnect WITH the alias.
    dav = net_disconnect_argv(net, to_name)
    _do, _ds, _de = run_capture(eng, dav, null)
    list_free(dav)
    cav = net_connect_alias_argv(net, to_name, alias)
    out, status, err = run_capture(eng, cav, null)
    list_free(cav)
    if err != "" {
        return "aeo: cutover connect-alias failed for '${to_name}': ${err}"
    }
    if status != 0 {
        return "aeo: cutover connect-alias failed for '${to_name}' (exit ${status}): ${out}"
    }
    // blue: drop it from the net so `alias` now resolves ONLY to green.
    bdav = net_disconnect_argv(net, from_name)
    _bo, _bs, _be = run_capture(eng, bdav, null)
    list_free(bdav)
    return ""
}

// `<engine> exec NAME /bin/sh -c "HEALTH"` — run the health command
// INSIDE the container; exit 0 == healthy.
exec_health_argv(res_name: string, health: string) -> ptr {
    av = list_new()
    list_add(av, "exec")
    list_add(av, res_name)
    list_add(av, "/bin/sh")
    list_add(av, "-c")
    list_add(av, health)
    return av
}

// --- exec'ing entry points -------------------------------------------

// Bring the container up idempotently. Returns "" on success, else an
// error message. `image` is required; `cmd` "" = image default; `expose`
// > 0 publishes that port to the host; `engine_pref` "" = auto-select.
up(res_name: string, image: string, cmd: string, expose: int, engine_pref: string) -> string {
    return up_net(res_name, image, cmd, expose, "", "", engine_pref)
}

// up_net — like up, plus a shared `net` (peers resolve by name) and `env`
// ("K=V,K=V"). Used for the host-container path so app can reach db by name.
up_net(res_name: string, image: string, cmd: string, expose: int, net: string, env: string, engine_pref: string) -> string {
    return up_confined(res_name, image, cmd, expose, net, env, "", "", engine_pref)
}

// up_confined — up_net plus `confine`, the lib/confine_linux flag string
// (cgroup caps + cap-drop/seccomp + netpolicy). The CONFINED host-container path.
up_confined(res_name: string, image: string, cmd: string, expose: int, net: string, env: string, confine: string, shares: string, engine_pref: string) -> string {
    return up_confined2(res_name, image, cmd, expose, 0, "", net, env, confine, shares, engine_pref)
}

// up_confined2 — up_confined plus `inner` (asymmetric publish container-port; 0
// = symmetric) and `ep` (exec_entrypoint path; "" = sh -c form). The runner
// calls this directly for container nodes so publish(ext,inn)/exec_entrypoint()
// reach the run argv; the 9-arg up_confined stays as the default-args shim for
// every other caller.
up_confined2(res_name: string, image: string, cmd: string, expose: int, inner: int, ep: string, net: string, env: string, confine: string, shares: string, engine_pref: string) -> string {
    eng = ensure_engine(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker on PATH; auto-install failed or disabled)"
    }
    if image == "" {
        return "aeo: container '${res_name}' has no image() set"
    }
    // Already running? idempotent no-op.
    if probe(res_name, "", engine_pref) == 1 {
        return ""
    }
    // podman gets `--replace` (in-place idempotency); docker has no such flag,
    // so its path pre-clears any stopped leftover and runs a replace-less argv.
    // RETRY with backoff — a fresh podman install has a transient window where
    // `run` returns 125 (the post-install race the child-bootstrap script also
    // rides), and an image pull can hit a network blip. A single attempt made
    // these self-healing failures fatal; a bounded retry recovers them WITHOUT
    // the orchestrator re-dispatching — retry/recover built into the driver, not
    // the caller. Idempotent: --replace / _pre_clear_for makes re-running safe.
    t = 0
    lastout = ""
    laststatus = 0
    while t < RUN_RETRIES() {
        with_replace = _pre_clear_for(eng, res_name)
        av = _run_argv_core2(res_name, image, cmd, expose, inner, ep, net, env, confine, shares, with_replace)
        out, status, err = run_capture(eng, av, null)
        list_free(av)
        if err == "" {
            if status == 0 {
                return ""
            }
        }
        lastout = out
        laststatus = status
        t = t + 1
        if t < RUN_RETRIES() {
            _sleep_s(3)
        }
    }
    return "aeo: '${eng} run' failed for '${res_name}' after retries (exit ${laststatus}): ${lastout}"
}

// Bounded run retries — covers the post-install 125 race + a transient image
// pull. Tunable via AEO_LINUX_RUN_RETRIES (default 8; ~8*3s = 24s of recovery).
RUN_RETRIES() -> int {
    v = getenv("AEO_LINUX_RUN_RETRIES")
    if v == null {
        return 8
    }
    n = string_get_int(v)
    if n < 1 {
        return 8
    }
    return n
}
// sleep n seconds via /bin/sh (shell-out discipline; no stdlib sleep imported).
_sleep_s(n: int) {
    av = list_new()
    list_add(av, "-c")
    list_add(av, "sleep ${_itoa(n)}")
    _o, _s, _e = run_capture("/bin/sh", av, null)
    list_free(av)
}

// The docker half of `--replace`: quiet-shell `rm -f` any leftover (absent =
// no-op; run_capture inherits child stderr, hence the redirect). Returns the
// with_replace flag for _run_argv_core: 0 on docker, 1 (use --replace) on podman.
_pre_clear_for(eng: string, res_name: string) -> int {
    if _is_docker(eng) == 0 {
        return 1
    }
    rmav = list_new()
    list_add(rmav, "-c")
    list_add(rmav, "${eng} rm -f ${res_name} >/dev/null 2>&1")
    _ro, _rs, _re = run_capture("/bin/sh", rmav, null)
    list_free(rmav)
    return 0
}

// 1 iff the resolved engine binary is docker (path suffix — engine_resolve
// returns absolute paths).
_is_docker(eng: string) -> int {
    return string_ends_with(eng, "docker")
}

// up_green — stand the GREEN container up beside blue for a cutover: same image/
// confinement, joined to the SAME shared `net` (so the alias swap works), but with
// NO service alias yet (green earns the alias only at the cut) and NO host port
// publish (blue still owns :expose until retired). `green_name` is the distinct
// container name (e.g. "<node>-green"). Returns "" on success. The confinement is
// passed through unchanged — green must come up CONFINED before it can serve (the
// blue-green security invariant).
up_green(green_name: string, image: string, cmd: string, net: string, env: string, confine: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker on PATH)"
    }
    if image == "" {
        return "aeo: green '${green_name}' has no image() set"
    }
    if probe(green_name, "", engine_pref) == 1 {
        return ""
    }
    // expose=0: blue owns the published host port; green joins the net for the
    // in-cluster alias cut only.
    with_replace = _pre_clear_for(eng, green_name)
    av = _run_argv_core(green_name, image, cmd, 0, net, env, confine, "", with_replace)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return "aeo: green spawn failed for '${green_name}': ${err}"
    }
    if status != 0 {
        return "aeo: green '${eng} run' failed for '${green_name}' (exit ${status}): ${out}"
    }
    return ""
}

// Tear the container down. Absent container == success (idempotent).
down(res_name: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker on PATH)"
    }
    // stop (ignore failure — may already be stopped), then rm -f.
    sav = stop_argv(res_name)
    _so, _ss, _se = run_capture(eng, sav, null)
    list_free(sav)
    rav = rm_argv(res_name)
    out, status, err = run_capture(eng, rav, null)
    list_free(rav)
    if err != "" {
        return "aeo: teardown spawn failed for '${res_name}': ${err}"
    }
    // `rm -f` on an absent container is non-fatal; only flag if the
    // message isn't the benign "no such container".
    if status != 0 {
        if string_contains(out, "no such container") == 1 {
            return ""
        }
        if string_contains(out, "No such container") == 1 {
            return ""
        }
        return "aeo: '${eng} rm' failed for '${res_name}' (exit ${status}): ${out}"
    }
    return ""
}

// down_many — tear a whole LEVEL of containers down in ONE engine sweep: each
// node's stop+rm runs as a BACKGROUND job in a single `sh -c "... & ...; wait"`,
// so the per-container stop grace (`stop -t 5` — up to 5s each while the
// workload handles SIGTERM) is paid ONCE per level, not once per node. Serial
// teardown of N slow-stopping containers is O(N×grace); this is O(grace) —
// measured 15.6s -> 6.3s at width 3 against real SIGTERM-ignoring containers.
// `names` is space-separated (aeo resource names — shell-safe by construction:
// they're already used bare as container names and env-var key material).
// Per-node stop/rm output is discarded — the ENGINE's gone-verification poller
// is the honest failure detector (teardown verifies disappearance), and it
// reports any lingering node loudly. Absent containers are non-events (rm -f).
down_many(names: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker on PATH)"
    }
    if string_length(names) == 0 {
        return ""
    }
    av = list_new()
    list_add(av, "-c")
    list_add(av, down_many_command(names, eng))
    out, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if err != "" {
        return "aeo: batch teardown spawn failed: ${err}"
    }
    return ""
}

// The pure command builder for down_many (unit-testable off-box): one shell
// line that backgrounds `stop -t 5` + `rm -f` per name and waits for all.
down_many_command(names: string, eng: string) -> string {
    return "for n in ${names}; do { ${eng} stop -t 5 \"$n\"; ${eng} rm -f \"$n\"; } >/dev/null 2>&1 & done; wait"
}

// Liveness probe. Returns 1 if alive (running, and the health command —
// when given — exits 0 inside the container), else 0. `health` "" means
// "running is enough".
//
// Returns a plain int (not a tuple) deliberately: Aether can't return a
// freshly-CONSTRUCTED tuple literal (only forward another tuple-returning
// call), and `wait_for_it_to_be_up` only needs alive/not-alive to poll.
// Probe-time spawn errors are treated as "not alive" — the resource is
// unreachable, which is what the poller must act on anyway.
probe(res_name: string, health: string, engine_pref: string) -> int {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return 0
    }
    pav = ps_running_argv(res_name)
    out, status, err = run_capture(eng, pav, null)
    list_free(pav)
    if err != "" {
        return 0
    }
    // ps prints the name iff running; empty output == not running.
    if string_length(out) == 0 {
        return 0
    }
    if health == "" {
        return 1
    }
    hav = exec_health_argv(res_name, health)
    hout, hstatus, herr = run_capture(eng, hav, null)
    list_free(hav)
    if herr != "" {
        return 0
    }
    if hstatus == 0 {
        return 1
    }
    return 0
}

// --- reconcile: read a container's ACTUAL rendered properties ---------------
//
// probe() answers only alive/dead. The reconcile loop (aeo watch) needs the live
// VALUES of the confinement + image properties aeo rendered at up-time, to diff
// against what the composition now declares. inspect_state returns them as one
// canonical `key=val|key=val` line (stable key order), "" if the container is
// absent. The keys mirror what up_confined sets: image, mem (--memory bytes), pids
// (--pids-limit), nanocpus (--cpus), net (joined networks). The DESIRED side
// (compose) renders the same shape; a field-by-field diff is then apples-to-apples.

// inspect_argv(res_name) — `<engine> inspect NAME --format '<canonical>'`. Pure
// (the format template is fixed), so the shape is unit-testable without a host.
inspect_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "inspect")
    list_add(av, res_name)
    list_add(av, "--format")
    // one canonical line; PidsLimit/Memory are 0 when unset (no cap declared).
    list_add(av, "img={{.ImageName}}|mem={{.HostConfig.Memory}}|pids={{.HostConfig.PidsLimit}}|nanocpus={{.HostConfig.NanoCpus}}|net={{range $k,$v := .NetworkSettings.Networks}}{{$k}},{{end}}")
    return av
}

// inspect_state(res_name, engine_pref) — the live canonical property line, or ""
// if the container doesn't exist (inspect exits non-zero) or no engine. The
// reconcile "actual" side.
inspect_state(res_name: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return ""
    }
    av = inspect_argv(res_name)
    // run_full (not run_capture): captures the engine's stderr SEPARATELY so a
    // "No such object" on an absent container (the normal dry-run/reconcile
    // case) is swallowed rather than inherited onto aeo's own stderr.
    out, _eout, status, err = run_full(eng, av, null, "")
    list_free(av)
    if err != "" {
        return ""
    }
    if status != 0 {
        return ""
    }
    // strip a trailing newline for a clean canonical value.
    n = string_length(out)
    if n > 0 {
        if string_char_at(out, n - 1) == 10 {
            return string_substring(out, 0, n - 1)
        }
    }
    return out
}

// --- death forensics: the KERNEL's verdict on a dead container ---------------
//
// death_state pulls the ENGINE's post-mortem fields for a node (podman AND
// docker both expose State.OOMKilled/ExitCode) as the canonical
// status|oom|exit line; the substrate-agnostic classification of that line
// into a human verdict lives in lib/death (death.death_cause), shared with the
// systemd-unit kinds (nspawn/firecracker). Reading the cgroup's memory.events
// oom_kill counter directly (ground truth when the engine under-reports
// rootless OOMs) is the follow-up.

// death_argv(res_name) — `<engine> inspect NAME --format '<post-mortem>'`. Pure.
death_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "inspect")
    list_add(av, res_name)
    list_add(av, "--format")
    list_add(av, "status={{.State.Status}}|oom={{.State.OOMKilled}}|exit={{.State.ExitCode}}")
    return av
}

// death_state(res_name, engine_pref) — the live post-mortem line
// (status=<s>|oom=<bool>|exit=<n>), or "" if the container doesn't exist or no
// engine. Same stderr-swallowing shape as inspect_state (an absent container is
// the normal case, not an error to surface).
death_state(res_name: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return ""
    }
    av = death_argv(res_name)
    out, _eout, status, err = run_full(eng, av, null, "")
    list_free(av)
    if err != "" {
        return ""
    }
    if status != 0 {
        return ""
    }
    n = string_length(out)
    if n > 0 {
        if string_char_at(out, n - 1) == 10 {
            return string_substring(out, 0, n - 1)
        }
    }
    return out
}

// --- extract: walk live containers -> facts for lib/extract ------------------
//
// `aeo extract` reconstructs a composition from running containers. list_running()
// returns their names (newline-sep); extract_facts(name) returns one pipe-delimited
// fact line richer than inspect_state (adds command + published port) that the
// runner splits and feeds to lib/extract.render_node. image_digest(image) resolves
// the current sha256 for the attest() pre-fill.

// list_running(engine_pref) — newline-separated names of all running containers, ""
// if none/no engine. (running_names already does this; alias for the extract path.)
list_running(engine_pref: string) -> string {
    return running_names(engine_pref)
}

// extract_argv(name) — inspect one container into a pipe line:
//   name=<n>|img=<image>|mem=<bytes>|pids=<n>|cmd=<argv-join>|port=<p/proto>
extract_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "inspect")
    list_add(av, res_name)
    list_add(av, "--format")
    list_add(av, "name={{.Name}}|img={{.ImageName}}|mem={{.HostConfig.Memory}}|pids={{.HostConfig.PidsLimit}}|cmd={{range .Config.Cmd}}{{.}} {{end}}|port={{range $p,$b := .HostConfig.PortBindings}}{{$p}}{{end}}")
    return av
}

// extract_facts(name, engine_pref) — the pipe line for one container, "" on failure.
extract_facts(res_name: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" { return "" }
    av = extract_argv(res_name)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" { return "" }
    if status != 0 { return "" }
    n = string_length(out)
    if n > 0 {
        if string_char_at(out, n - 1) == 10 {
            return string_substring(out, 0, n - 1)
        }
    }
    return out
}

// image_digest(image, engine_pref) — the image's current content digest
// ("sha256:...") for the extract attest() pre-fill, "" if unresolvable.
image_digest(image: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" { return "" }
    av = list_new()
    list_add(av, "image")
    list_add(av, "inspect")
    list_add(av, image)
    list_add(av, "--format")
    list_add(av, "{{.Digest}}")
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" { return "" }
    if status != 0 { return "" }
    n = string_length(out)
    if n > 0 {
        if string_char_at(out, n - 1) == 10 {
            return string_substring(out, 0, n - 1)
        }
    }
    return out
}

// Run `cmd` inside the container via `<engine> exec NAME /bin/sh -c CMD`
// and return its stdout (trimmed of a trailing newline). "" on any spawn
// failure / non-zero exit. This is the "make a node compute something and
// read the result" primitive — the executable counterpart to probe's
// boolean liveness. (The eventual nested/remote path is the same shape
// over ssh into a guest instead of `engine exec`.)
exec_capture(res_name: string, cmd: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return ""
    }
    av = exec_health_argv(res_name, cmd)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return ""
    }
    if status != 0 {
        return ""
    }
    return _chomp(out)
}

// The image tag aeo builds an inline-Dockerfile resource under. (Resource
// names already tend to be aeo-prefixed by the operator, so the tag uses
// the name as-is under an aeo-built/ repo to avoid double-prefixing.)
built_tag(res_name: string) -> string {
    return "localhost/aeo-built/${res_name}:latest"
}

// `<engine> build -t TAG -f DOCKERFILE CONTEXTDIR`
build_argv(tag: string, dockerfile_path: string, context_dir: string) -> ptr {
    av = list_new()
    list_add(av, "build")
    list_add(av, "-t")
    list_add(av, tag)
    list_add(av, "-f")
    list_add(av, dockerfile_path)
    list_add(av, context_dir)
    return av
}

// Build an image from inline Dockerfile `text`, tagged for `res_name`. The
// text is written to a temp Dockerfile (no parent→child stdin primitive is
// exposed, so a file is the clean path) and built with that as the context
// dir. Returns "" on success, else an error message. The resulting tag is
// built_tag(res_name).
build(res_name: string, text: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker)"
    }
    dfdir = "/tmp/aeo-build-${res_name}"
    _ = _mkdir(dfdir)
    dfpath = "${dfdir}/Dockerfile"
    werr = write_atomic(dfpath, text, string_length(text))
    if werr != "" {
        return "aeo: cannot write Dockerfile for '${res_name}': ${werr}"
    }
    tag = built_tag(res_name)
    av = build_argv(tag, dfpath, dfdir)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return "aeo: image build spawn failed for '${res_name}': ${err}"
    }
    if status != 0 {
        return "aeo: image build failed for '${res_name}' (exit ${status}): ${out}"
    }
    return ""
}

// build_from_containerfile — build from an EXISTING Containerfile against a
// source-tree context (the out-of-line form: `containerfile()`+`build_context()`).
// Both paths must already be ABSOLUTE (the runner resolves them against the
// composition dir). Unlike build()/build_entrypoint(), it writes nothing to a
// temp dir — it builds the real Containerfile against the real context, so a
// multi-stage `COPY . /src` build sees the actual project. Returns "" on success.
build_from_containerfile(res_name: string, cf_abs: string, ctx_abs: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker)"
    }
    tag = built_tag(res_name)
    av = build_argv(tag, cf_abs, ctx_abs)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return "aeo: image build spawn failed for '${res_name}': ${err}"
    }
    if status != 0 {
        return "aeo: image build failed for '${res_name}' (exit ${status}) from ${cf_abs}: ${out}"
    }
    return ""
}

// build_entrypoint — build a host container image from an entrypoint() script
// SOURCE: write the body to /<file> + a COPY-based Dockerfile
// (FROM base; COPY <file> /<file>; CMD [<run>, /<file>]) into the build context,
// then build. Language-neutral: `file` (e.g. app.rb) and `run` (e.g. ruby) come
// from compose's entrypoint_lang table; `base` is the resolved default FROM (or
// the operator's base() override). The host-container peer of
// driver_vm.guest_container_up's entrypoint path. Returns "" on success.
build_entrypoint(res_name: string, src: string, base: string, file: string, run: string, engine_pref: string) -> string {
    eng = engine_resolve(engine_pref)
    if eng == "" {
        return "aeo: no container engine found (need podman or docker)"
    }
    b = base
    if string_length(b) == 0 {
        b = "docker.io/library/python:3-alpine"
    }
    f = file
    if string_length(f) == 0 { f = "app.py" }
    r = run
    if string_length(r) == 0 { r = "python" }
    dfdir = "/tmp/aeo-build-${res_name}"
    _ = _mkdir(dfdir)
    // source written verbatim (no escaping); the Dockerfile just COPYs it —
    // builds on every podman, unlike a RUN heredoc.
    perr = write_atomic("${dfdir}/${f}", src, string_length(src))
    if perr != "" {
        return "aeo: cannot write ${f} for '${res_name}': ${perr}"
    }
    df = "FROM ${b}\nCOPY ${f} /${f}\nCMD [\"${r}\", \"/${f}\"]"
    derr = write_atomic("${dfdir}/Dockerfile", df, string_length(df))
    if derr != "" {
        return "aeo: cannot write Dockerfile for '${res_name}': ${derr}"
    }
    tag = built_tag(res_name)
    av = build_argv(tag, "${dfdir}/Dockerfile", dfdir)
    out, status, err = run_capture(eng, av, null)
    list_free(av)
    if err != "" {
        return "aeo: image build spawn failed for '${res_name}': ${err}"
    }
    if status != 0 {
        return "aeo: image build failed for '${res_name}' (exit ${status}): ${out}"
    }
    return ""
}

_mkdir(path: string) -> int {
    av = list_new()
    list_add(av, "-p")
    list_add(av, path)
    out, status, err = run_capture("/bin/mkdir", av, null)
    list_free(av)
    return status
}

_itoa(n: int) -> string {
    if n == 0 {
        return "0"
    }
    v = n
    s = ""
    while v > 0 {
        d = v - (v / 10) * 10
        s = "${_digit_c(d)}${s}"
        v = v / 10
    }
    return s
}
_digit_c(x: int) -> string {
    if x == 0 { return "0" }
    if x == 1 { return "1" }
    if x == 2 { return "2" }
    if x == 3 { return "3" }
    if x == 4 { return "4" }
    if x == 5 { return "5" }
    if x == 6 { return "6" }
    if x == 7 { return "7" }
    if x == 8 { return "8" }
    return "9"
}

// Strip a single trailing newline from command output.
_chomp(s: string) -> string {
    n = string_length(s)
    if n == 0 {
        return s
    }
    last = string_char_at(s, n - 1)
    if last == 10 {
        return string_substring(s, 0, n - 1)
    }
    return s
}
