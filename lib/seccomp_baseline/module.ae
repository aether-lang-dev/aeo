// Derived from containers/common pkg/seccomp/seccomp.json @ a5ccdae846b629b5ceaefa6ffd5c6511409c3487,
// Apache-2.0, Copyright 2013-2018 Docker, Inc. Modified: the JSON rule list is
// re-encoded as one line per rule (format below); no rule was added, dropped or
// reordered. See NOTICE.
//
// lib/seccomp_baseline — the DEFAULT container syscall profile, as data. This
// is the table podman and docker apply when nobody says otherwise: deny by
// default (ENOSYS), ~370 syscalls allowed outright, a few allowed only for
// certain arguments, architectures or capabilities.
//
// aeo carries its own copy so that the profile a node boots under is the SAME
// on every host and is known to aeo (it can be digested and audited), rather
// than "whatever file this host's engine happens to ship". lib/syscall_policy
// TIGHTENS it; nothing in aeo loosens it.
//
// THIS MODULE IS DATA ONLY and is the only derived part. Keep it that way: no
// logic here, so the original code around it stays free to move to the MIT
// siblings (AGENTS.md, "Licence & provenance").
//
// One rule per line, seven fields separated by "|":
//   ACTION | errno | arches | caps-required | caps-absent | args | names
//   ACTION         ALLOW or ERRNO
//   errno          the errno an ERRNO rule returns (1 = EPERM); "" for ALLOW
//   arches         rule applies only on these architectures ("" = all)
//   caps-required  rule applies only if the container HAS all of these
//   caps-absent    rule applies only if the container has NONE of these
//   args           "INDEX:OP:VALUE" joined by "&" (OP is EQ or NE); "" = any
//   names          the syscalls, comma-separated
//
// To refresh: re-run the conversion over a newer upstream seccomp.json and
// update the commit above and in NOTICE. The spec pins the rule count.

exports (
    source, default_errno, arch_map_json, rules
)

// Where this table came from, for the audit trail.
source() -> string {
    return "containers/common@a5ccdae846b6"
}

// What a syscall named by NO rule returns: ENOSYS, so a program probing for a
// newer syscall falls back instead of treating the refusal as fatal.
default_errno() -> int {
    return 38
}

// Which 32-bit ABIs ride along with each 64-bit architecture. Passed through
// to the engine verbatim.
arch_map_json() -> string {
    return <<ARCHMAP
[{"architecture":"SCMP_ARCH_X86_64","subArchitectures":["SCMP_ARCH_X86","SCMP_ARCH_X32"]},{"architecture":"SCMP_ARCH_AARCH64","subArchitectures":["SCMP_ARCH_ARM"]},{"architecture":"SCMP_ARCH_MIPS64","subArchitectures":["SCMP_ARCH_MIPS","SCMP_ARCH_MIPS64N32"]},{"architecture":"SCMP_ARCH_MIPS64N32","subArchitectures":["SCMP_ARCH_MIPS","SCMP_ARCH_MIPS64"]},{"architecture":"SCMP_ARCH_MIPSEL64","subArchitectures":["SCMP_ARCH_MIPSEL","SCMP_ARCH_MIPSEL64N32"]},{"architecture":"SCMP_ARCH_MIPSEL64N32","subArchitectures":["SCMP_ARCH_MIPSEL","SCMP_ARCH_MIPSEL64"]},{"architecture":"SCMP_ARCH_S390X","subArchitectures":["SCMP_ARCH_S390"]}]
ARCHMAP
}

rules() -> string {
    return <<RULES
ERRNO|1|||||bdflush,cachestat,futex_requeue,futex_wait,futex_waitv,futex_wake,io_pgetevents,io_pgetevents_time64,kexec_file_load,kexec_load,map_shadow_stack,migrate_pages,move_pages,nfsservctl,nice,oldfstat,oldlstat,oldolduname,oldstat,olduname,pciconfig_iobase,pciconfig_read,pciconfig_write,sgetmask,ssetmask,swapoff,swapon,syscall,sysfs,uselib,userfaultfd,ustat,vm86,vm86old,vmsplice
